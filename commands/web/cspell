#!/usr/bin/env bash
#ddev-generated

## Description: Run CSpell spell-checking (Drupal standards). Pass --accept-words to add found words to the project dictionary.
## Usage: cspell [flags] [pattern]
## Example: "ddev cspell" or "ddev cspell --accept-words"
## ExecRaw: true
## HostWorkingDir: true

WEB_ROOT="${DDEV_DOCROOT:-web}"

# Prefer web/core/node_modules/.bin/cspell (the binary CI uses), then
# project-level node_modules, then the globally installed binary.
CSPELL="${DDEV_APPROOT}/${WEB_ROOT}/core/node_modules/.bin/cspell"
if [ ! -x "${CSPELL}" ]; then
  CSPELL="${DDEV_APPROOT}/node_modules/.bin/cspell"
  if [ ! -x "${CSPELL}" ]; then
    CSPELL="cspell"
  fi
fi

# shellcheck source=../../module-developer/lib/init.sh
source /mnt/ddev_config/module-developer/lib/init.sh

# --accept-words is handled by this script, not by the cspell binary. It does
# not fix any spelling — it only suppresses future failures by adding every
# currently-unrecognised word to the project dictionary. Strip it out of "$@"
# before it reaches cspell itself.
ACCEPT_WORDS_MODE=0
ARGS=()
for arg in "$@"; do
  if [ "${arg}" = "--accept-words" ]; then
    ACCEPT_WORDS_MODE=1
  else
    ARGS+=("${arg}")
  fi
done
set -- "${ARGS[@]}"
unset ARGS arg

# Download prepare-cspell.php from the GitLab Templates repository, exactly
# as the CI job does.
PREPARE_SCRIPT=$(mktemp /tmp/prepare-cspell-XXXXXX.php)
CONFIG_BACKUP=""
DICT_TMP=""

cleanup() {
  rm -f "${PREPARE_SCRIPT}"
  [ -n "${CONFIG_BACKUP}" ] && rm -f "${CONFIG_BACKUP}"
  [ -n "${DICT_TMP}" ] && rm -f "${DICT_TMP}"
}
trap cleanup EXIT

curl -fsSL -o "${PREPARE_SCRIPT}" \
  https://git.drupalcode.org/project/gitlab_templates/-/raw/default-ref/scripts/prepare-cspell.php

# If the project has its own .cspell.json, back it up before prepare-cspell.php
# modifies it in place. Otherwise download the canonical default from the
# GitLab Templates repository (identical to the CI job).
HAS_CONFIG=0
if [ -f ".cspell.json" ]; then
  HAS_CONFIG=1
  CONFIG_BACKUP=$(mktemp /tmp/cspell-config-XXXXXX.json)
  cp ".cspell.json" "${CONFIG_BACKUP}"
else
  curl -fsSL -o ".cspell.json" \
    https://git.drupalcode.org/project/gitlab_templates/-/raw/default-ref/assets/.cspell.json
fi

# Parse _CSPELL_* variables from .gitlab-ci.yml if present, replicating what
# CI sets automatically from the pipeline variables block.
if [ -f ".gitlab-ci.yml" ]; then
  for var in _CSPELL_WORDS _CSPELL_FLAGWORDS _CSPELL_IGNORE_PATHS _CSPELL_IGNORE_STANDARD_FILES _CSPELL_DICTIONARY; do
    value=$(grep -m1 "^\s*${var}:" ".gitlab-ci.yml" | sed -E "s/^\s*${var}:\s*//" | tr -d "'\"")
    if [ -n "${value}" ]; then
      export "${var}=${value}"
    fi
  done
fi

# Mirror the CI default: _CSPELL_DICTIONARY defaults to .cspell-project-words.txt.
# prepare-cspell.php only registers the dictionary when this variable is set,
# so without this default the file is silently ignored when running locally.
export _CSPELL_DICTIONARY="${_CSPELL_DICTIONARY:-.cspell-project-words.txt}"

# Run prepare-cspell.php, which modifies .cspell.json in place.
# Set the CI environment variables the script depends on.
export _WEB_ROOT="${DDEV_APPROOT}/${WEB_ROOT}"
export CI_PROJECT_NAME
CI_PROJECT_NAME=$(basename "$(pwd)")
export CI_PROJECT_DIR
CI_PROJECT_DIR=$(pwd)
php "${PREPARE_SCRIPT}"

if [ "${ACCEPT_WORDS_MODE}" -eq 1 ]; then
  # Harvest unrecognised words instead of reporting them as failures, and
  # merge them into the project dictionary (deduped and sorted). This does
  # not fix any misspellings — it only accepts words into the dictionary so
  # they stop being reported.
  WORDS_OUTPUT=$("${CSPELL}" -c .cspell.json --words-only --unique --no-progress "${@:-.}")
  WORDS_EXIT_CODE=$?

  if [ -z "${WORDS_OUTPUT}" ] && [ "${WORDS_EXIT_CODE}" -ne 0 ]; then
    # No words were harvested and cspell reported a failure: something other
    # than "found unknown words" went wrong (e.g. a config error). Surface it
    # rather than silently reporting "no new words".
    EXIT_CODE=${WORDS_EXIT_CODE}
  else
    DICT_FILE="${_CSPELL_DICTIONARY}"
    BEFORE_COUNT=0
    [ -f "${DICT_FILE}" ] && BEFORE_COUNT=$(grep -c '' "${DICT_FILE}")

    DICT_TMP=$(mktemp /tmp/cspell-dict-XXXXXX.txt)
    {
      [ -f "${DICT_FILE}" ] && cat "${DICT_FILE}"
      [ -n "${WORDS_OUTPUT}" ] && printf '%s\n' "${WORDS_OUTPUT}"
    } | sort -u | awk 'NF' > "${DICT_TMP}"
    mv "${DICT_TMP}" "${DICT_FILE}"
    DICT_TMP=""

    AFTER_COUNT=$(grep -c '' "${DICT_FILE}")
    NEW_WORDS=$((AFTER_COUNT - BEFORE_COUNT))
    if [ "${NEW_WORDS}" -gt 0 ]; then
      printf "cspell --accept-words: added %d new word(s) to %s\n" "${NEW_WORDS}" "${DICT_FILE}"
    else
      printf "cspell --accept-words: no new words found; %s unchanged\n" "${DICT_FILE}"
    fi
    EXIT_CODE=0
  fi
else
  # Invoke cspell with the same flags and path as the CI job.
  "${CSPELL}" -c .cspell.json --show-suggestions --show-context --no-progress "${@:-.}"
  EXIT_CODE=$?
fi

# Restore or remove .cspell.json.
if [ "${HAS_CONFIG}" -eq 1 ]; then
  cp "${CONFIG_BACKUP}" ".cspell.json"
else
  rm -f ".cspell.json"
fi
rm -f ".cspell.json.bak"

exit ${EXIT_CODE}
